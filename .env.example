# ==== docker-compose: variáveis raiz ====

# Porta pública da aplicação (frontend).
APP_PORT=8080

# Segurança — OBRIGATÓRIO. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

ENVIRONMENT=production

# Banco de dados Postgres (usado pelo serviço db e pelo backend).
POSTGRES_DB=financa_facil
POSTGRES_USER=financa
# Defina uma senha forte para o Postgres (não deixe em branco em produção).
POSTGRES_PASSWORD=

# Origens permitidas (onde o frontend é servido).
CORS_ORIGINS=http://localhost:8080

# OpenAI (opcional). Sem a chave, a extração usa heurística e o chat fica desativado.
OPENAI_API_KEY=
