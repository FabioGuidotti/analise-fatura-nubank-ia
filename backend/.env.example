# ==== Segurança (OBRIGATÓRIO em produção) ====
# Gere uma chave forte com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ==== Banco de dados ====
# SQLite (padrão, zero config):
DATABASE_URL=sqlite:///./financa_facil.db
# PostgreSQL (produção):
# DATABASE_URL=postgresql+psycopg://usuario:senha@postgres:5432/financa_facil

# ==== CORS (origens do frontend separadas por vírgula) ====
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==== OpenAI (opcional — sem ela o extrator heurístico é usado) ====
OPENAI_API_KEY=
OPENAI_MODEL_EXTRACTION=gpt-4o-mini
OPENAI_MODEL_CHAT=gpt-4o-mini
